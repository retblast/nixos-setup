+def _nearest_wcag_background(preferred, foregrounds, extra_candidates=(), min_ratio=4.5):
+    """Return the closest background that passes contrast with all text colors."""
+    preferred = _opaque_hex(preferred)
+    foregrounds = [_opaque_hex(foreground) for foreground in foregrounds]
+    foregrounds = [foreground for foreground in foregrounds if foreground is not None]
+    if preferred is None or not foregrounds:
+        return preferred, True
+
+    candidates = list(_candidate_colors_near(preferred, extra_candidates))
+    candidates.sort(key=lambda color: _oklab_distance(preferred, color))
+
+    for color in candidates:
+        if _passes_contrast(color, foregrounds, min_ratio):
+            return color, True
+
+    return max(
+        candidates,
+        key=lambda color: (
+            min(_ratios(color, foregrounds)),
+            -_oklab_distance(preferred, color),
+        ),
+    ), False
+
