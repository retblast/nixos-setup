diff -ruN old/tests/test_scheme_contrast_states.py new/tests/test_scheme_contrast_states.py
--- old/tests/test_scheme_contrast_states.py	1970-01-01 00:00:00.000000000 +0000
+++ new/tests/test_scheme_contrast_states.py	2026-08-09 17:28:13.516223730 +0000
@@ -0,0 +1,106 @@
+import unittest
+
+from kde_material_you_colors.schemeconfigs import (
+	_contrast_ratio,
+	_parse_kde_scheme,
+	_repair_interactive_state_backgrounds,
+	_scheme_value,
+)
+
+
+LIGHT_SCHEME = """[Colors:View]
+BackgroundNormal=#f5f5f5
+DecorationFocus=#95d6f2
+DecorationHover=#1b6872
+ForegroundNormal=#4a4a4a
+
+[Colors:Window]
+BackgroundNormal=#f5f5f5
+DecorationFocus=#95d6f2
+DecorationHover=#1b6872
+ForegroundNormal=#4a4a4a
+
+[Colors:Header]
+BackgroundNormal=#f5f5f5
+DecorationFocus=#95d6f2
+DecorationHover=#1b6872
+ForegroundNormal=#4a4a4a
+
+[Colors:Button]
+BackgroundNormal=#f5f5f5
+DecorationFocus=#95d6f2
+DecorationHover=#1b6872
+ForegroundNormal=#4a4a4a
+
+[Colors:Tooltip]
+BackgroundNormal=#f5f5f5
+DecorationFocus=#95d6f2
+DecorationHover=#1b6872
+ForegroundNormal=#4a4a4a
+"""
+
+
+DARK_SCHEME = """[Colors:View]
+BackgroundNormal=#171a1c
+DecorationFocus=#9cc8d2
+DecorationHover=#d7eef2
+ForegroundNormal=#f1f4f5
+
+[Colors:Window]
+BackgroundNormal=#171a1c
+DecorationFocus=#9cc8d2
+DecorationHover=#d7eef2
+ForegroundNormal=#f1f4f5
+
+[Colors:Header]
+BackgroundNormal=#171a1c
+DecorationFocus=#9cc8d2
+DecorationHover=#d7eef2
+ForegroundNormal=#f1f4f5
+
+[Colors:Button]
+BackgroundNormal=#171a1c
+DecorationFocus=#9cc8d2
+DecorationHover=#d7eef2
+ForegroundNormal=#f1f4f5
+
+[Colors:Tooltip]
+BackgroundNormal=#171a1c
+DecorationFocus=#9cc8d2
+DecorationHover=#d7eef2
+ForegroundNormal=#f1f4f5
+"""
+
+
+class InteractiveStateContrastTests(unittest.TestCase):
+	def _repair(self, scheme):
+		lines, sections = _parse_kde_scheme(scheme)
+		_repair_interactive_state_backgrounds(lines, sections, "test")
+		return lines, sections
+
+	def test_light_hover_repairs_cross_set_menu_state(self):
+		lines, sections = self._repair(LIGHT_SCHEME)
+		hover = _scheme_value(sections, "Colors:View", "DecorationHover")
+		window_text = _scheme_value(sections, "Colors:Window", "ForegroundNormal")
+		self.assertGreaterEqual(_contrast_ratio(window_text, hover), 4.5)
+		self.assertNotEqual(hover, "#1b6872")
+
+	def test_dark_hover_repairs_light_state_fill(self):
+		lines, sections = self._repair(DARK_SCHEME)
+		hover = _scheme_value(sections, "Colors:View", "DecorationHover")
+		window_text = _scheme_value(sections, "Colors:Window", "ForegroundNormal")
+		self.assertGreaterEqual(_contrast_ratio(window_text, hover), 4.5)
+		self.assertNotEqual(hover, "#d7eef2")
+
+	def test_compliant_state_is_left_alone(self):
+		lines, sections = self._repair(
+			LIGHT_SCHEME.replace("DecorationHover=#1b6872", "DecorationHover=#a8e3ea")
+		)
+		self.assertEqual(
+			_scheme_value(sections, "Colors:View", "DecorationHover"),
+			"#a8e3ea",
+		)
+
+
+if __name__ == "__main__":
+	unittest.main()
