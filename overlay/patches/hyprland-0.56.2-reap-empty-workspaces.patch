diff --git a/src/desktop/Workspace.cpp b/src/desktop/Workspace.cpp
index 16e1909..b20bf14 100644
--- a/src/desktop/Workspace.cpp
+++ b/src/desktop/Workspace.cpp
@@ -403,6 +403,21 @@ void CWorkspace::markInert() {
     m_monitor.reset();
 }
 
+void CWorkspace::tryReap() {
+    if (m_inert || m_isSpecialWorkspace || m_persistent || m_id <= 0)
+        return;
+
+    const auto PMONITOR = m_monitor.lock();
+    if (PMONITOR && (PMONITOR->m_activeWorkspace == m_self.lock() || PMONITOR->m_activeSpecialWorkspace == m_self.lock()))
+        return;
+
+    if (getWindowCount() > 0)
+        return;
+
+    Log::logger->log(Log::DEBUG, "reaping empty workspace id {}", m_id);
+    markInert();
+}
+
 bool CWorkspace::inert() {
     return m_inert;
 }
