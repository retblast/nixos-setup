+def _repair_kde_scheme_contrast(scheme, mode):
+    """Post-process a generated KDE color scheme for WCAG contrast.
+
+    This is intentionally a repair pass over the already generated .colors text,
+    not a rewrite of the Material -> KDE mapping.  The generator keeps choosing
+    the palette; this pass only nudges foregrounds, and occasionally shared
+    state backgrounds, when known KDE/Breeze role pairs fail readability.
+    """
+    lines, sections = _parse_kde_scheme(scheme)
+
+    # First make Selection itself readable.  Many KDE/Breeze states borrow its
+    # foreground, so it is the anchor for the rest of the state checks.
+    selection_backgrounds = (
+        ("Colors:Selection", "BackgroundNormal"),
+        ("Colors:Selection", "BackgroundAlternate"),
+    )
+    for key in ("ForegroundNormal", "ForegroundActive", "ForegroundInactive"):
+        _repair_foreground(
+            lines,
+            sections,
+            mode,
+            "Colors:Selection",
+            key,
+            selection_backgrounds,
+            _WCAG_NORMAL_TEXT_CONTRAST,
+        )
+
+    _repair_interactive_state_backgrounds(lines, sections, mode)
+
+    # Re-check Selection after state backgrounds have been made coherent.
+    selection_state_backgrounds = selection_backgrounds + (
+        ("Colors:Selection", "DecorationFocus"),
+        ("Colors:Selection", "DecorationHover"),
+        ("Colors:View", "DecorationFocus"),
+        ("Colors:View", "DecorationHover"),
+        ("Colors:Button", "DecorationFocus"),
+        ("Colors:Button", "DecorationHover"),
+        ("Colors:Tooltip", "DecorationFocus"),
+        ("Colors:Tooltip", "DecorationHover"),
+    )
+    for key in ("ForegroundNormal", "ForegroundActive", "ForegroundInactive"):
+        _repair_foreground(
+            lines,
+            sections,
+            mode,
+            "Colors:Selection",
+            key,
+            selection_state_backgrounds,
+            _WCAG_NORMAL_TEXT_CONTRAST,
+        )
+
+    normal_text_checks = {
+        "Colors:View": (
+            ("Colors:View", "BackgroundNormal"),
+            ("Colors:Window", "BackgroundNormal"),
+        ),
+        "Colors:Window": (("Colors:Window", "BackgroundNormal"),),
+        "Colors:Button": (("Colors:Button", "BackgroundNormal"),),
+        "Colors:Tooltip": (("Colors:Tooltip", "BackgroundNormal"),),
+        "Colors:Complementary": (("Colors:Complementary", "BackgroundNormal"),),
+        "Colors:Header": (("Colors:Header", "BackgroundNormal"),),
+        "Colors:Header][Inactive": (("Colors:Header][Inactive", "BackgroundNormal"),),
+    }
+
+    for section, backgrounds in normal_text_checks.items():
+        _repair_foreground(
+            lines,
+            sections,
+            mode,
+            section,
+            "ForegroundNormal",
+            backgrounds,
+            _WCAG_NORMAL_TEXT_CONTRAST,
+        )
+        _repair_foreground(
+            lines,
+            sections,
+            mode,
+            section,
+            "ForegroundInactive",
+            backgrounds,
+            _WCAG_MUTED_TEXT_CONTRAST,
+        )
+
+    active_text_checks = {
+        "Colors:Button": (
+            ("Colors:Button", "DecorationFocus"),
+            ("Colors:Button", "DecorationHover"),
+        ),
+        "Colors:Tooltip": (
+            ("Colors:Tooltip", "DecorationFocus"),
+            ("Colors:Tooltip", "DecorationHover"),
+        ),
+        "Colors:Complementary": (("Colors:Complementary", "BackgroundNormal"),),
+        "Colors:Header": (("Colors:Header", "BackgroundNormal"),),
+        "Colors:Header][Inactive": (("Colors:Header][Inactive", "BackgroundNormal"),),
+        "Colors:Window": (("Colors:Window", "BackgroundNormal"),),
+    }
+
+    for section, backgrounds in active_text_checks.items():
+        _repair_foreground(
+            lines,
+            sections,
+            mode,
+            section,
+            "ForegroundActive",
+            backgrounds,
+            _WCAG_NORMAL_TEXT_CONTRAST,
+        )
+
+    wm_checks = {
+        "activeForeground": (("WM", "activeBackground"),),
+        "inactiveForeground": (("WM", "inactiveBackground"),),
+    }
+    for key, backgrounds in wm_checks.items():
+        _repair_foreground(
+            lines,
+            sections,
+            mode,
+            "WM",
+            key,
+            backgrounds,
+            _WCAG_NORMAL_TEXT_CONTRAST,
+        )
+
+    suffix = "\n" if scheme.endswith("\n") else ""
+    return "\n".join(lines) + suffix
