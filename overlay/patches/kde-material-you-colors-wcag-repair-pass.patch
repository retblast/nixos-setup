+def _parse_kde_scheme(scheme):
+    lines = scheme.splitlines()
+    sections = {}
+    current_section = None
+
+    for index, line in enumerate(lines):
+        stripped = line.strip()
+        if stripped.startswith("[") and stripped.endswith("]"):
+            current_section = stripped[1:-1]
+            sections.setdefault(current_section, {})
+            continue
+        if current_section is None or stripped.startswith("#") or "=" not in stripped:
+            continue
+
+        key, value = stripped.split("=", 1)
+        sections[current_section][key] = (index, value.strip())
+
+    return lines, sections
+
+
+def _scheme_value(sections, section, key):
+    try:
+        return sections[section][key][1]
+    except KeyError:
+        return None
+
+
+def _set_scheme_value(lines, sections, section, key, value):
+    try:
+        index, _old_value = sections[section][key]
+    except KeyError:
+        return False
+
+    lines[index] = f"{key}={value}"
+    sections[section][key] = (index, value)
+    return True
+
+
+def _background_values(sections, refs):
+    backgrounds = []
+    for section, key in refs:
+        value = _scheme_value(sections, section, key)
+        if _opaque_hex(value) is not None:
+            backgrounds.append(value)
+    return backgrounds
+
+
+def _foreground_candidates(sections):
+    candidates = []
+    candidate_keys = (
+        "ForegroundNormal",
+        "ForegroundActive",
+        "ForegroundInactive",
+        "ForegroundLink",
+        "ForegroundVisited",
+    )
+    candidate_sections = (
+        "Colors:View",
+        "Colors:Window",
+        "Colors:Button",
+        "Colors:Selection",
+        "Colors:Tooltip",
+        "Colors:Complementary",
+        "Colors:Header",
+        "WM",
+    )
+
+    for section in candidate_sections:
+        for key in candidate_keys:
+            value = _scheme_value(sections, section, key)
+            if _opaque_hex(value) is not None:
+                candidates.append(value)
+
+    for key in ("activeForeground", "inactiveForeground"):
+        value = _scheme_value(sections, "WM", key)
+        if _opaque_hex(value) is not None:
+            candidates.append(value)
+
+    candidates.extend(("#000000", "#ffffff"))
+    return candidates
+
+
+def _repair_foreground(lines, sections, mode, section, key, background_refs, min_ratio):
+    foreground = _scheme_value(sections, section, key)
+    backgrounds = _background_values(sections, background_refs)
+    normalized = _opaque_hex(foreground)
+    if normalized is None or not backgrounds:
+        return
+
+    if _passes_contrast(normalized, backgrounds, min_ratio):
+        logging.debug(
+            "WCAG check %s %s.%s ok: %s on [%s]",
+            mode,
+            section,
+            key,
+            normalized,
+            _ratios_text(normalized, backgrounds),
+        )
+        return
+
+    repaired, compliant = _nearest_wcag_foreground(
+        normalized,
+        backgrounds,
+        _foreground_candidates(sections),
+        min_ratio,
+    )
+    if repaired is None or repaired == normalized:
+        return
+
+    _set_scheme_value(lines, sections, section, key, repaired)
+    logging.warning(
+        "WCAG repair %s %s.%s: %s [%s] -> %s [%s]%s",
+        mode,
+        section,
+        key,
+        normalized,
+        _ratios_text(normalized, backgrounds),
+        repaired,
+        _ratios_text(repaired, backgrounds),
+        "" if compliant else " (best effort; backgrounds conflict)",
+    )
+
