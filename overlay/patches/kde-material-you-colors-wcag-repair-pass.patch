+_WCAG_NORMAL_TEXT_CONTRAST = 4.5
+_WCAG_MUTED_TEXT_CONTRAST = 3.0
+_HEX_COLOR_RE = re.compile(r"^#[0-9a-fA-F]{6}$")
+_HEX_ALPHA_COLOR_RE = re.compile(r"^#[0-9a-fA-F]{8}$")
