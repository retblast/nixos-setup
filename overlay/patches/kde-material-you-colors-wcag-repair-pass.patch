+def _hls_color(hex_color, lightness, saturation_scale=1.0):
+    r, g, b = hex2rgb(hex_color)
+    hue, _old_lightness, saturation = colorsys.rgb_to_hls(r / 255, g / 255, b / 255)
+    saturation = max(0.0, min(1.0, saturation * saturation_scale))
+    r, g, b = colorsys.hls_to_rgb(hue, lightness, saturation)
+    return rgb2hex(int(round(r * 255)), int(round(g * 255)), int(round(b * 255)))
