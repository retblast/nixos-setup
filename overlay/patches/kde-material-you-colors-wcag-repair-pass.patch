+def _candidate_colors_near(preferred, extra_candidates=()):
+    """Yield candidate text colors ordered later by perceptual distance.
+
+    The search keeps hue/saturation stable first, then tries slightly calmer
+    variants, and only then falls back to black/white.  This keeps themes from
+    turning into random high-contrast confetti when only a small lightness move
+    was needed.
+    """
+    preferred = _opaque_hex(preferred)
+    seen = set()
+
+    def add(color):
+        color = _opaque_hex(color)
+        if color is None or color in seen:
+            return
+        seen.add(color)
+        yield color
+
+    yield from add(preferred)
+    for color in extra_candidates:
+        yield from add(color)
+
+    for saturation_scale in (1.0, 0.88, 0.72, 0.55):
+        for step in range(1, 100):
+            yield from add(_hls_color(preferred, step / 100, saturation_scale))
+
+    yield from add("#000000")
+    yield from add("#ffffff")
+
+
+def _ratios(color, backgrounds):
+    return [_contrast_ratio(color, background) for background in backgrounds]
+
+
+def _ratios_text(color, backgrounds):
+    return ", ".join(f"{ratio:.2f}:1" for ratio in _ratios(color, backgrounds))
+
+
+def _passes_contrast(color, backgrounds, min_ratio):
+    return all(ratio >= min_ratio for ratio in _ratios(color, backgrounds))
+
+
+def _nearest_wcag_foreground(preferred, backgrounds, extra_candidates=(), min_ratio=4.5):
+    """Return the closest foreground that passes all supplied backgrounds.
+
+    Contrast is pair-based, so the caller can provide more than one background
+    when KDE/Breeze reuses a foreground role across hover, focus, or selection
+    fills.  If no single foreground can satisfy all backgrounds, return the best
+    compromise and mark it as non-compliant so the caller can repair backgrounds.
+    """
+    preferred = _opaque_hex(preferred)
+    backgrounds = [_opaque_hex(background) for background in backgrounds]
+    backgrounds = [background for background in backgrounds if background is not None]
+    if preferred is None or not backgrounds:
+        return preferred, True
+
+    candidates = list(_candidate_colors_near(preferred, extra_candidates))
+    candidates.sort(key=lambda color: _oklab_distance(preferred, color))
+
+    for color in candidates:
+        if _passes_contrast(color, backgrounds, min_ratio):
+            return color, True
+
+    return max(
+        candidates,
+        key=lambda color: (
+            min(_ratios(color, backgrounds)),
+            -_oklab_distance(preferred, color),
+        ),
+    ), False
+
