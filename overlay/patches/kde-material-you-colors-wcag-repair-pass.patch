+def _opaque_hex(color):
+    """Return a #rrggbb color for contrast math.
+
+    KDE color files can contain #aarrggbb values for translucent window-manager
+    backgrounds.  Contrast still needs an opaque estimate, so the alpha channel
+    is ignored instead of letting the checker silently skip the titlebar pair.
+    """
+    if not isinstance(color, str):
+        return None
+
+    color = color.strip()
+    if _HEX_COLOR_RE.match(color):
+        return color.lower()
+    if _HEX_ALPHA_COLOR_RE.match(color):
+        return f"#{color[-6:]}".lower()
+    return None
+
+
+def _srgb_to_linear(channel):
+    channel = channel / 255.0
+    if channel <= 0.04045:
+        return channel / 12.92
+    return ((channel + 0.055) / 1.055) ** 2.4
+
+
+def _relative_luminance(color):
+    r, g, b = hex2rgb(color)
+    return (
+        0.2126 * _srgb_to_linear(r)
+        + 0.7152 * _srgb_to_linear(g)
+        + 0.0722 * _srgb_to_linear(b)
+    )
+
+
+def _contrast_ratio(color_a, color_b):
+    color_a = _opaque_hex(color_a)
+    color_b = _opaque_hex(color_b)
+    if color_a is None or color_b is None:
+        return 0.0
+
+    lum_a = _relative_luminance(color_a)
+    lum_b = _relative_luminance(color_b)
+    lighter = max(lum_a, lum_b)
+    darker = min(lum_a, lum_b)
+    return (lighter + 0.05) / (darker + 0.05)
+
+
+def _cuberoot(value):
+    if value < 0:
+        return -((-value) ** (1.0 / 3.0))
+    return value ** (1.0 / 3.0)
+
+
+def _oklab(color):
+    """Convert sRGB to Oklab for perceptual-ish distance scoring."""
+    color = _opaque_hex(color)
+    r, g, b = hex2rgb(color)
+    r = _srgb_to_linear(r)
+    g = _srgb_to_linear(g)
+    b = _srgb_to_linear(b)
+
+    l = _cuberoot(0.4122214708 * r + 0.5363325363 * g + 0.0514459929 * b)
+    m = _cuberoot(0.2119034982 * r + 0.6806995451 * g + 0.1073969566 * b)
+    s = _cuberoot(0.0883024619 * r + 0.2817188376 * g + 0.6299787005 * b)
+
+    return (
+        0.2104542553 * l + 0.7936177850 * m - 0.0040720468 * s,
+        1.9779984951 * l - 2.4285922050 * m + 0.4505937099 * s,
+        0.0259040371 * l + 0.7827717662 * m - 0.8086757660 * s,
+    )
+
+
+def _oklab_distance(color_a, color_b):
+    lab_a = _oklab(color_a)
+    lab_b = _oklab(color_b)
+    return math.sqrt(sum((a - b) ** 2 for a, b in zip(lab_a, lab_b)))
+
