+def _repair_interactive_state_backgrounds(lines, sections, mode):
+    """Keep shared KDE/Breeze state backgrounds coherent.
+
+    Breeze can use Selection text over View/Button/Tooltip decoration fills for
+    menu-bar and pressed states.  When that shared text cannot read on a state
+    background, prefer reusing the canonical Selection background over inventing
+    a new color per section.  That keeps the palette visually tied together.
+    """
+    selection_background = _scheme_value(sections, "Colors:Selection", "BackgroundNormal")
+    selection_text = _scheme_value(sections, "Colors:Selection", "ForegroundNormal")
+    selection_background = _opaque_hex(selection_background)
+    selection_text = _opaque_hex(selection_text)
+    if selection_background is None or selection_text is None:
+        return
+
+    state_refs = (
+        ("Colors:Selection", "DecorationFocus"),
+        ("Colors:Selection", "DecorationHover"),
+        ("Colors:View", "DecorationFocus"),
+        ("Colors:View", "DecorationHover"),
+        ("Colors:Button", "DecorationFocus"),
+        ("Colors:Button", "DecorationHover"),
+        ("Colors:Tooltip", "DecorationFocus"),
+        ("Colors:Tooltip", "DecorationHover"),
+        ("Colors:Complementary", "DecorationFocus"),
+        ("Colors:Complementary", "DecorationHover"),
+        ("Colors:Header", "DecorationFocus"),
+        ("Colors:Header", "DecorationHover"),
+        ("Colors:Header][Inactive", "DecorationFocus"),
+        ("Colors:Header][Inactive", "DecorationHover"),
+        ("Colors:Window", "DecorationFocus"),
+        ("Colors:Window", "DecorationHover"),
+    )
+
+    for section, key in state_refs:
+        background = _scheme_value(sections, section, key)
+        background = _opaque_hex(background)
+        if background is None:
+            continue
+        if _contrast_ratio(selection_text, background) >= _WCAG_NORMAL_TEXT_CONTRAST:
+            continue
+        _set_scheme_value(lines, sections, section, key, selection_background)
+        logging.warning(
+            "WCAG state repair %s %s.%s: %s -> %s so Selection text %s stays readable",
+            mode,
+            section,
+            key,
+            background,
+            selection_background,
+            selection_text,
+        )
+
