# Tune elanspi capture acceptance: reject ultra-short swipes, keep more
# enrollment stages.
#
# - Swipes that assemble to fewer than ELANSPI_MIN_SWIPE_HEIGHT (110) rows
#   carry too few minutiae to ever match. Previously they were stored as
#   garbage templates; now the scan is retried with FP_DEVICE_RETRY_TOO_SHORT
#   ("The swipe was too short, please try again"), which skips the stage.
#
# - nr_enroll_stages 7 -> 12: this sensor is hit-or-miss; more stages build
#   a taller, more diverse template that a later verify can align against.
#
# Verified on Taihou: enroll accepted 12/12 tall swipes, rejected a ~59-row
# swipe, and 4/4 verify rounds matched.
diff --git a/libfprint/drivers/elanspi.h b/libfprint/drivers/elanspi.h
--- a/libfprint/drivers/elanspi.h
+++ b/libfprint/drivers/elanspi.h
@@ -374,6 +374,7 @@
 #define ELANSPI_MAX_FRAMES_SWIPE (20 + ELANSPI_SWIPE_FRAMES_DISCARD)
 
 #define ELANSPI_MAX_FRAME_HEIGHT 43
+#define ELANSPI_MIN_SWIPE_HEIGHT 110
 #define ELANSPI_MIN_FRAME_TO_FRAME_DIFF (250 * 250)
 
 #define ELANSPI_HV_SENSOR_FRAME_DELAY 23
diff --git a/libfprint/drivers/elanspi.c b/libfprint/drivers/elanspi.c
--- a/libfprint/drivers/elanspi.c
+++ b/libfprint/drivers/elanspi.c
@@ -1349,6 +1349,16 @@
 
   fpi_do_movement_estimation (&assembling_ctx, frame_start);
   img = fpi_assemble_frames (&assembling_ctx, frame_start);
+
+  /* Ultra-short swipes yield too few minutiae to ever match; reject them
+   * and ask the user to swipe again instead of storing noise. */
+  if (img->height < ELANSPI_MIN_SWIPE_HEIGHT)
+    {
+      fp_dbg ("<fp_frame> swipe too short (%d rows), retrying", img->height);
+      fpi_image_device_retry_scan (FP_IMAGE_DEVICE (self), FP_DEVICE_RETRY_TOO_SHORT);
+      g_slist_free_full (g_steal_pointer (&self->fp_frame_list), g_free);
+      return;
+    }
   scaled = fpi_image_resize (img, 2, 2);
 
   scaled->flags |= FPI_IMAGE_PARTIAL | FPI_IMAGE_COLORS_INVERTED;
@@ -1700,7 +1710,7 @@
   dev_class->type = FP_DEVICE_TYPE_UDEV;
   dev_class->id_table = elanspi_id_table;
   dev_class->scan_type = FP_SCAN_TYPE_SWIPE;
-  dev_class->nr_enroll_stages = 7;       /* these sensors are very hit or miss, may as well record a few extras */
+  dev_class->nr_enroll_stages = 12;      /* these sensors are very hit or miss, record extra stages */
