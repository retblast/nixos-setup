diff --git a/src/truetype/ttgload.c b/src/truetype/ttgload.c
index f9a54c4..5c1afaf 100644
--- a/src/truetype/ttgload.c
+++ b/src/truetype/ttgload.c
@@ -2346,6 +2346,122 @@
   }
 
 
+  static FT_Int
+  tt_compute_darkening_amount( TT_Face  face,
+                               TT_Size  size,
+                               FT_Bool  vertical )
+  {
+    TT_Driver  driver = (TT_Driver)FT_FACE_DRIVER( face );
+    FT_Int*    params = driver->darken_params;
+
+    FT_Long   units_per_em = face->root.units_per_EM;
+    FT_Long   std_stem;
+    FT_Pos    stem_width;
+    FT_Long   scaled_stem;
+    FT_Int    x1, y1, x2, y2, x3, y3, x4, y4;
+    FT_Int    amount;
+
+
+    if ( units_per_em <= 0 )
+      units_per_em = 1000;
+
+    /*
+     * TrueType has no standard stem-width dictionary entries comparable to
+     * Type 2's StdVW and StdHW.  Use the same fallback values as the CFF
+     * Adobe engine: 75/1000em for vertical stems and 110/1000em for
+     * horizontal stems.
+     */
+    std_stem = FT_MulDiv( units_per_em, vertical ? 110 : 75, 1000 );
+    stem_width = FT_MulFix( std_stem,
+                            vertical ? size->root.metrics.y_scale
+                                     : size->root.metrics.x_scale );
+    if ( stem_width <= 0 )
+      return 0;
+
+    scaled_stem = FT_MulDiv( stem_width, 1000, 64 );
+
+    x1 = params[0];
+    y1 = params[1];
+    x2 = params[2];
+    y2 = params[3];
+    x3 = params[4];
+    y3 = params[5];
+    x4 = params[6];
+    y4 = params[7];
+
+    if ( scaled_stem < x1 )
+      amount = y1;
+    else if ( scaled_stem < x2 )
+      amount = x2 == x1 ? y2
+                        : y1 + FT_MulDiv( scaled_stem - x1,
+                                           y2 - y1,
+                                           x2 - x1 );
+    else if ( scaled_stem < x3 )
+      amount = x3 == x2 ? y3
+                        : y2 + FT_MulDiv( scaled_stem - x2,
+                                           y3 - y2,
+                                           x3 - x2 );
+    else if ( scaled_stem < x4 )
+      amount = x4 == x3 ? y4
+                        : y3 + FT_MulDiv( scaled_stem - x3,
+                                           y4 - y3,
+                                           x4 - x3 );
+    else
+      amount = y4;
+
+    return amount > 0 ? (FT_Int)FT_MulDiv( amount, 64, 1000 ) : 0;
+  }
+
+
+  static FT_Error
+  tt_apply_stem_darkening( TT_Loader  loader )
+  {
+    TT_GlyphSlot  glyph  = (TT_GlyphSlot)loader->glyph;
+    TT_Face       face   = loader->face;
+    TT_Size       size   = loader->size;
+    TT_Driver     driver = (TT_Driver)FT_FACE_DRIVER( face );
+
+    FT_Char  no_stem_darkening_font =
+               glyph->face->internal->no_stem_darkening;
+
+    FT_Int  xstrength;
+    FT_Int  ystrength;
+
+
+    if ( loader->load_flags & FT_LOAD_NO_SCALE )
+      return FT_Err_Ok;
+
+    if ( glyph->outline.n_points <= 0 )
+      return FT_Err_Ok;
+
+    if ( no_stem_darkening_font > 0                         ||
+         ( no_stem_darkening_font < 0 &&
+           driver->no_stem_darkening )                      )
+      return FT_Err_Ok;
+
+    xstrength = tt_compute_darkening_amount( face, size, FALSE );
+    ystrength = tt_compute_darkening_amount( face, size, TRUE  );
+
+    /*
+     * Native TrueType hinting can snap stems so strongly to the pixel grid
+     * that post-hint outline darkening becomes visually too subtle.  Boost
+     * the amount for hinted grayscale/LCD rendering, but keep the documented
+     * half-pixel upper bound.
+     */
+    if ( IS_HINTED( loader->load_flags ) &&
+         FT_LOAD_TARGET_MODE( loader->load_flags ) != FT_RENDER_MODE_MONO )
+    {
+      xstrength = FT_MIN( xstrength * 3 / 2, 32 );
+      ystrength = FT_MIN( ystrength * 3 / 2, 32 );
+    }
+
+    if ( !xstrength && !ystrength )
+      return FT_Err_Ok;
+
+    return FT_Outline_EmboldenXY( &glyph->outline, xstrength, ystrength );
+  }
+
+
   /**************************************************************************
    *
    * @Function:
@@ -2617,6 +2733,15 @@
 
 #endif /* TT_USE_BYTECODE_INTERPRETER */
 
+      error = tt_apply_stem_darkening( &loader );
+      if ( error )
+      {
+        FT_TRACE2(( "TT_Load_Glyph: stem darkening failed"
+                    " for glyph index %u (error code 0x%x)\n",
+                    glyph_index, error ));
+        error = FT_Err_Ok;
+      }
+
       error = compute_glyph_metrics( &loader, glyph_index );
     }
 
